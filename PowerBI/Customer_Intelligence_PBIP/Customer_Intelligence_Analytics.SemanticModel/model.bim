{
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "dim_calendar",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "Month Key",
            "dataType": "string",
            "sourceColumn": "Month Key"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "formatString": "#,0"
          },
          {
            "name": "Quarter",
            "dataType": "string",
            "sourceColumn": "Quarter"
          }
        ],
        "partitions": [
          {
            "name": "dim_calendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Binary = Binary.FromText(\"\", BinaryEncoding.Base64),",
                "    Source = Csv.Document(Binary, [Delimiter=\",\", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Date\", type date}, {\"Month\", type text}, {\"Month Key\", type text}, {\"Year\", Int64.Type}, {\"Quarter\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "monthly_customer_metrics",
        "columns": [
          {
            "name": "Month",
            "dataType": "dateTime",
            "sourceColumn": "Month",
            "formatString": "mmm yyyy"
          },
          {
            "name": "Month Key",
            "dataType": "string",
            "sourceColumn": "Month Key"
          },
          {
            "name": "Net Revenue",
            "dataType": "double",
            "sourceColumn": "Net Revenue"
          },
          {
            "name": "Gross Margin",
            "dataType": "double",
            "sourceColumn": "Gross Margin"
          },
          {
            "name": "Active Customers",
            "dataType": "int64",
            "sourceColumn": "Active Customers",
            "formatString": "#,0"
          },
          {
            "name": "New Customers",
            "dataType": "int64",
            "sourceColumn": "New Customers",
            "formatString": "#,0"
          },
          {
            "name": "Orders",
            "dataType": "int64",
            "sourceColumn": "Orders",
            "formatString": "#,0"
          },
          {
            "name": "Average Order Value",
            "dataType": "double",
            "sourceColumn": "Average Order Value"
          },
          {
            "name": "Gross Margin Rate",
            "dataType": "double",
            "sourceColumn": "Gross Margin Rate"
          },
          {
            "name": "Repeat Customer Rate",
            "dataType": "double",
            "sourceColumn": "Repeat Customer Rate"
          },
          {
            "name": "Return Rate",
            "dataType": "double",
            "sourceColumn": "Return Rate"
          },
          {
            "name": "Predicted CLV",
            "dataType": "double",
            "sourceColumn": "Predicted CLV"
          },
          {
            "name": "Revenue at Risk",
            "dataType": "double",
            "sourceColumn": "Revenue at Risk"
          },
          {
            "name": "Customers",
            "dataType": "double",
            "sourceColumn": "Customers"
          },
          {
            "name": "Churn Probability",
            "dataType": "double",
            "sourceColumn": "Churn Probability"
          },
          {
            "name": "Average Recency Days",
            "dataType": "double",
            "sourceColumn": "Average Recency Days"
          },
          {
            "name": "Campaign Budget",
            "dataType": "double",
            "sourceColumn": "Campaign Budget"
          },
          {
            "name": "Campaign Expected Margin",
            "dataType": "double",
            "sourceColumn": "Campaign Expected Margin"
          },
          {
            "name": "Campaign ROI",
            "dataType": "double",
            "sourceColumn": "Campaign ROI"
          },
          {
            "name": "Churn ROC-AUC",
            "dataType": "double",
            "sourceColumn": "Churn ROC-AUC"
          }
        ],
        "partitions": [
          {
            "name": "monthly_customer_metrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Binary = Binary.FromText(\"\", BinaryEncoding.Base64),",
                "    Source = Csv.Document(Binary, [Delimiter=\",\", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Month\", type date}, {\"Month Key\", type text}, {\"Net Revenue\", type number}, {\"Gross Margin\", type number}, {\"Active Customers\", Int64.Type}, {\"New Customers\", Int64.Type}, {\"Orders\", Int64.Type}, {\"Average Order Value\", type number}, {\"Gross Margin Rate\", type number}, {\"Repeat Customer Rate\", type number}, {\"Return Rate\", type number}, {\"Predicted CLV\", type number}, {\"Revenue at Risk\", type number}, {\"Customers\", type number}, {\"Churn Probability\", type number}, {\"Average Recency Days\", type number}, {\"Campaign Budget\", type number}, {\"Campaign Expected Margin\", type number}, {\"Campaign ROI\", type number}, {\"Churn ROC-AUC\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "KPI Net Revenue",
            "expression": "SUM(monthly_customer_metrics[Net Revenue])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Revenue Prior Year",
            "expression": "CALCULATE([KPI Net Revenue],DATEADD(dim_calendar[Date],-1,YEAR))",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Gross Margin",
            "expression": "SUM(monthly_customer_metrics[Gross Margin])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Active Customers",
            "expression": "SUM(monthly_customer_metrics[Active Customers])",
            "formatString": "#,0"
          },
          {
            "name": "KPI Predicted CLV",
            "expression": "MAX(monthly_customer_metrics[Predicted CLV])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Revenue at Risk",
            "expression": "MAX(monthly_customer_metrics[Revenue at Risk])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI New Customers",
            "expression": "SUM(monthly_customer_metrics[New Customers])",
            "formatString": "#,0"
          },
          {
            "name": "KPI Campaign Budget",
            "expression": "MAX(monthly_customer_metrics[Campaign Budget])",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Customers",
            "expression": "MAX(monthly_customer_metrics[Customers])",
            "formatString": "#,0"
          },
          {
            "name": "KPI Recency Days",
            "expression": "AVERAGE(monthly_customer_metrics[Average Recency Days])",
            "formatString": "0.0"
          },
          {
            "name": "KPI Gross Margin Rate",
            "expression": "DIVIDE([KPI Gross Margin],[KPI Net Revenue],0)",
            "formatString": "0.0%"
          },
          {
            "name": "KPI Churn Probability",
            "expression": "MAX(monthly_customer_metrics[Churn Probability])",
            "formatString": "0.0%"
          },
          {
            "name": "KPI Campaign ROI",
            "expression": "MAX(monthly_customer_metrics[Campaign ROI])",
            "formatString": "0.00x"
          },
          {
            "name": "KPI Churn ROC-AUC",
            "expression": "MAX(monthly_customer_metrics[Churn ROC-AUC])",
            "formatString": "0.000"
          },
          {
            "name": "KPI Net Revenue PY",
            "expression": "CALCULATE([KPI Net Revenue],DATEADD(dim_calendar[Date],-1,YEAR))",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Predicted CLV Benchmark",
            "expression": "[KPI Predicted CLV]",
            "formatString": "₺#,0"
          },
          {
            "name": "KPI Net Revenue YoY %",
            "expression": "DIVIDE([KPI Net Revenue]-[KPI Net Revenue PY],[KPI Net Revenue PY],0)",
            "formatString": "0.0%"
          },
          {
            "name": "KPI Revenue YoY Change",
            "expression": "[KPI Net Revenue]-[KPI Net Revenue PY]",
            "formatString": "₺#,0"
          }
        ]
      },
