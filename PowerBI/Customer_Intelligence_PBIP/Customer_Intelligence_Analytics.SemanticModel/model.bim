                "    Source = Csv.Document(Binary, [Delimiter=\",\", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Customer ID\", type text}, {\"Snapshot Date\", type date}, {\"Region\", type text}, {\"Age Band\", type text}, {\"Loyalty Tier\", type text}, {\"Preferred Channel\", type text}, {\"Recency Days\", type number}, {\"Frequency 12M\", type number}, {\"Revenue 12M\", type number}, {\"Gross Margin 12M\", type number}, {\"Average Order Value 12M\", type number}, {\"RFM Segment\", type text}, {\"Predicted CLV 12M\", type number}, {\"CLV Band\", type text}, {\"Churn Probability\", type number}, {\"Risk Band\", type text}, {\"Recommended Action\", type text}, {\"Campaign Priority\", type text}, {\"Expected Incremental Margin\", type number}, {\"Selected for Campaign\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
