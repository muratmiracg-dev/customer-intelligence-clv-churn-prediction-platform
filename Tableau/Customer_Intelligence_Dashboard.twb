<?xml version='1.0' encoding='utf-8'?>
<workbook original-version="18.1" source-build="2026.1" source-platform="win" version="18.1" xml:base="https://localhost:8080">
 <preferences>
  <preference name="ui.encoding.shelf.height" value="24" />
 </preferences>
 <datasources>
  <datasource caption="Customer 360" inline="true" name="federated.customer360" version="18.1">
   <connection class="textscan" directory="../Data/Processed" filename="customer_360.csv" password="" server="" />
   <aliases enabled="yes" />
   <column datatype="string" name="[Customer ID]" role="dimension" type="nominal" />
   <column datatype="date" name="[Snapshot Date]" role="dimension" type="ordinal" />
   <column datatype="string" name="[Region]" role="dimension" type="nominal" />
   <column datatype="string" name="[Age Band]" role="dimension" type="nominal" />
   <column datatype="string" name="[Loyalty Tier]" role="dimension" type="nominal" />
   <column datatype="string" name="[Preferred Channel]" role="dimension" type="nominal" />
   <column datatype="integer" name="[Recency Days]" role="measure" type="quantitative" />
   <column datatype="integer" name="[Frequency 12M]" role="measure" type="quantitative" />
   <column datatype="real" name="[Revenue 12M]" role="measure" type="quantitative" />
   <column datatype="real" name="[Gross Margin 12M]" role="measure" type="quantitative" />
   <column datatype="real" name="[Average Order Value 12M]" role="measure" type="quantitative" />
   <column datatype="string" name="[RFM Segment]" role="dimension" type="nominal" />
   <column datatype="real" name="[Predicted CLV 12M]" role="measure" type="quantitative" />
   <column datatype="string" name="[CLV Band]" role="dimension" type="nominal" />
   <column datatype="real" name="[Churn Probability]" role="measure" type="quantitative" />
   <column datatype="string" name="[Risk Band]" role="dimension" type="nominal" />
   <column datatype="string" name="[Recommended Action]" role="dimension" type="nominal" />
   <column datatype="string" name="[Campaign Priority]" role="dimension" type="nominal" />
   <column datatype="real" name="[Expected Incremental Margin]" role="measure" type="quantitative" />
   <column datatype="integer" name="[Selected for Campaign]" role="measure" type="quantitative" />
   <column caption="Value at Risk" datatype="real" name="[Value at Risk]" role="measure" type="quantitative">
    <calculation class="tableau" formula="IF [Churn Probability] &gt;= 0.55 THEN [Revenue 12M] ELSE 0 END" />
   </column>
   <column caption="Strategic Risk Flag" datatype="integer" name="[Strategic Risk Flag]" role="measure" type="quantitative">
    <calculation class="tableau" formula="IF [CLV Band] = 'Strategic' AND [Risk Band] IN ('High','Critical') THEN 1 ELSE 0 END" />
   </column>
   <column caption="Campaign Selected Margin" datatype="real" name="[Campaign Selected Margin]" role="measure" type="quantitative">
    <calculation class="tableau" formula="IF [Selected for Campaign] = 1 THEN [Expected Incremental Margin] ELSE 0 END" />
   </column>
  </datasource>
 </datasources>
 <worksheets>
  <worksheet name="Executive KPI Table">
   <table>
    <view>
     <datasources>
      <datasource caption="Customer 360" name="federated.customer360" />
     </datasources>
     <slices>
      <column>[federated.customer360].[Snapshot Date]</column>
     </slices>
     <rows>[federated.customer360].[Customer ID]</rows>
     <cols>Measure Values</cols>
    </view>
   </table>
  </worksheet>
  <worksheet name="Revenue by RFM Segment">
   <table>
    <view>
     <datasources>
      <datasource caption="Customer 360" name="federated.customer360" />
     </datasources>
     <slices>
      <column>[federated.customer360].[Snapshot Date]</column>
     </slices>
     <rows>[federated.customer360].[RFM Segment]</rows>
     <cols>SUM([Revenue 12M])</cols>
    </view>
   </table>
  </worksheet>
  <worksheet name="CLV by RFM Segment">
   <table>
    <view>
     <datasources>
      <datasource caption="Customer 360" name="federated.customer360" />
     </datasources>
     <slices>
      <column>[federated.customer360].[Snapshot Date]</column>
     </slices>
     <rows>[federated.customer360].[RFM Segment]</rows>
     <cols>SUM([Predicted CLV 12M])</cols>
    </view>
   </table>
  </worksheet>
  <worksheet name="Churn Risk Distribution">
   <table>
    <view>
     <datasources>
      <datasource caption="Customer 360" name="federated.customer360" />
     </datasources>
     <slices>
      <column>[federated.customer360].[Snapshot Date]</column>
     </slices>
     <rows>[federated.customer360].[Risk Band]</rows>
     <cols>COUNTD([Customer ID])</cols>
    </view>
   </table>
  </worksheet>
  <worksheet name="Customer Value Risk Matrix">
   <table>
    <view>
     <datasources>
      <datasource caption="Customer 360" name="federated.customer360" />
     </datasources>
     <slices>
      <column>[federated.customer360].[Snapshot Date]</column>
     </slices>
     <rows>[federated.customer360].[Predicted CLV 12M]</rows>
     <cols>[Churn Probability]</cols>
    </view>
   </table>
  </worksheet>
  <worksheet name="Campaign Recommendations">
   <table>
    <view>
     <datasources>
      <datasource caption="Customer 360" name="federated.customer360" />
     </datasources>
     <slices>
      <column>[federated.customer360].[Snapshot Date]</column>
     </slices>
     <rows>[federated.customer360].[Recommended Action]</rows>
     <cols>SUM([Expected Incremental Margin])</cols>
    </view>
   </table>
  </worksheet>
  <worksheet name="Regional Risk Analysis">
   <table>
    <view>
     <datasources>
      <datasource caption="Customer 360" name="federated.customer360" />
     </datasources>
     <slices>
      <column>[federated.customer360].[Snapshot Date]</column>
     </slices>
     <rows>[federated.customer360].[Region]</rows>
     <cols>AVG([Churn Probability])</cols>
    </view>
   </table>
  </worksheet>
  <worksheet name="Customer Detail">
   <table>
    <view>
     <datasources>
      <datasource caption="Customer 360" name="federated.customer360" />
     </datasources>
     <slices>
      <column>[federated.customer360].[Snapshot Date]</column>
     </slices>
     <rows>[federated.customer360].[Customer ID]</rows>
     <cols>Measure Values</cols>
    </view>
   </table>
  </worksheet>
 </worksheets>
 <dashboards>
  <dashboard enable-sort-zone-taborder="true" name="Customer Intelligence - Executive Overview">
   <style />
   <zones>
    <zone h="100000" id="1" type-v2="layout-basic" w="100000" x="0" y="0" />
    <zone h="100000" id="2" name="Executive KPI Table" type-v2="worksheet" w="25000" x="0" y="0" />
    <zone h="100000" id="3" name="Revenue by RFM Segment" type-v2="worksheet" w="25000" x="25000" y="0" />
    <zone h="100000" id="4" name="Churn Risk Distribution" type-v2="worksheet" w="25000" x="50000" y="0" />
    <zone h="100000" id="5" name="Customer Value Risk Matrix" type-v2="worksheet" w="25000" x="75000" y="0" />
   </zones>
  </dashboard>
  <dashboard enable-sort-zone-taborder="true" name="Customer Intelligence - Segmentation &amp; CLV">
   <style />
   <zones>
    <zone h="100000" id="1" type-v2="layout-basic" w="100000" x="0" y="0" />
    <zone h="100000" id="2" name="CLV by RFM Segment" type-v2="worksheet" w="33333" x="0" y="0" />
    <zone h="100000" id="3" name="Regional Risk Analysis" type-v2="worksheet" w="33333" x="33333" y="0" />
    <zone h="100000" id="4" name="Customer Detail" type-v2="worksheet" w="33333" x="66666" y="0" />
   </zones>
  </dashboard>
  <dashboard enable-sort-zone-taborder="true" name="Customer Intelligence - Campaign Activation">
   <style />
   <zones>
    <zone h="100000" id="1" type-v2="layout-basic" w="100000" x="0" y="0" />
    <zone h="100000" id="2" name="Campaign Recommendations" type-v2="worksheet" w="33333" x="0" y="0" />
    <zone h="100000" id="3" name="Customer Value Risk Matrix" type-v2="worksheet" w="33333" x="33333" y="0" />
    <zone h="100000" id="4" name="Customer Detail" type-v2="worksheet" w="33333" x="66666" y="0" />
   </zones>
  </dashboard>
 </dashboards>
 <windows>
  <window class="dashboard" name="Customer Intelligence - Executive Overview">
   <viewpoints />
  </window>
  <window class="dashboard" name="Customer Intelligence - Segmentation &amp; CLV">
   <viewpoints />
  </window>
  <window class="dashboard" name="Customer Intelligence - Campaign Activation">
   <viewpoints />
  </window>
 </windows>
</workbook>